# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Any OpenRouter model id that supports JSON output
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Optional: use any other OpenAI-compatible provider instead of OpenRouter, e.g. Meta Model API.
# When set, these take precedence for the server key.
# LLM_BASE_URL=https://api.meta.ai/v1
# LLM_API_KEY=...
# LLM_MODEL=muse-spark-1.3
# LLM_REASONING_EFFORT=minimal
