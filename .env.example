# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Any OpenRouter model id that supports JSON output
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Optional: use any other OpenAI-compatible provider instead of OpenRouter, e.g. Meta Llama API.
# When set, these take precedence for the server key.
# LLM_BASE_URL=https://api.llama.com/compat/v1
# LLM_API_KEY=LLM|...
# LLM_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
